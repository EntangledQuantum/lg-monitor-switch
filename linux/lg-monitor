# ---------------------------------------------------------------------------
# Monitor protocol constants
# ---------------------------------------------------------------------------

DDC_ADDR = 0x37            # DDC/CI 7-bit slave address of the monitor
LG_SOURCE_ADDR = 0x50      # LG side-channel uses source 0x50 instead of 0x51
LG_INPUT_REGISTER = 0xF4   # LG manufacturer "input select" register
SET_VCP_OPCODE = 0x03

# Value written to register 0xF4 for each input (LG UltraGear family).
INPUTS = {"dp1": 0xD0, "dp2": 0xD1, "hdmi1": 0x90, "hdmi2": 0x91}
INPUT_LABELS = {
    "dp1": "DisplayPort",
    "dp2": "DisplayPort 2",
    "hdmi1": "HDMI 1",
    "hdmi2": "HDMI 2",
}
INPUT_ALIASES = {"dp": "dp1", "displayport": "dp1", "hdmi": "hdmi1"}

# The ONLY VCP codes this program will ever write.
WRITABLE_VCP = {0x10: "brightness", 0x12: "contrast"}

