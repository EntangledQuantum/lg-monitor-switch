class LgError(Exception):
    """User-facing error."""


def new_config():
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.optionxform = str  # keep the case of Deskflow screen names
    cfg.read_dict(DEFAULTS)
    return cfg


def load_config(path=None):
    cfg = new_config()
    path = path or CONFIG_FILE
    if os.path.exists(path):
        try:
            cfg.read(path, encoding="utf-8")
        except configparser.Error as exc:
            raise LgError("cannot parse %s: %s" % (path, exc))
    return cfg


def save_config(cfg, path=None):
    path = path or CONFIG_FILE
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("# lg-monitor configuration (see config.example.ini for documentation)\n")
        cfg.write(fh)
    os.replace(tmp, path)


def normalize_input(name):
    key = (name or "").strip().lower().replace(" ", "").replace("-", "").replace("_", "")
    key = INPUT_ALIASES.get(key, key)
    if key not in INPUTS:
        raise LgError("unknown input %r (use one of: %s)" % (name, ", ".join(sorted(INPUTS))))
    return key


def find_tool(name):
    path = shutil.which(name) or shutil.which(name, path="/usr/sbin:/sbin:/usr/bin:/bin:/usr/local/sbin:/usr/local/bin")
    if not path:
        pkg = "i2c-tools" if name.startswith("i2c") else name
        raise LgError("'%s' not found. Install it with: sudo apt install %s" % (name, pkg))
    return path


def ensure_runtime_dir():
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)


@contextlib.contextmanager
def ddc_lock():
    """Serialise all DDC traffic between the CLI, extension and services."""
    ensure_runtime_dir()
    with open(LOCK_FILE, "a+") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def run(cmd, timeout=15):
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             universal_newlines=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise LgError("timeout running %s" % " ".join(cmd))
    if res.returncode != 0:
        msg = (res.stderr.strip() or res.stdout.strip() or "exit code %d" % res.returncode)
        raise LgError("%s failed: %s" % (os.path.basename(cmd[0]), msg))
    return res.stdout


# ---------------------------------------------------------------------------
# Bus detection
# ---------------------------------------------------------------------------

def parse_detect(text, mfg="GSM", model="LG ULTRAGEAR"):
    """Parse `ddcutil detect --brief` output and return the I2C bus number of
    the first display whose monitor id matches mfg and contains model."""
    candidates = []
    for block in re.split(r"\n(?=\S)", text):
        bus = re.search(r"I2C bus:\s*/dev/i2c-(\d+)", block)
        mon = re.search(r"Monitor:\s*([^:\n]*):([^:\n]*):", block)
        if not bus or not mon:
            continue
        if mon.group(1).strip().upper() != mfg.strip().upper():
            continue
        if model.strip().upper() not in mon.group(2).strip().upper():
            continue
        valid = block.lstrip().startswith("Display")
        candidates.append((0 if valid else 1, int(bus.group(1))))
    if not candidates:
        return None
    return sorted(candidates)[0][1]


def detect_bus(cfg, use_cache=True):
    bus = cfg.get("monitor", "bus").strip().lower()
    if bus not in ("", "auto"):
        if not bus.isdigit():
            raise LgError("[monitor] bus must be 'auto' or a number, got %r" % bus)
        return int(bus)
    if use_cache:
        try:
            with open(BUS_CACHE_FILE) as fh:
                cached = int(fh.read().strip())
            if os.path.exists("/dev/i2c-%d" % cached):
                return cached
        except (OSError, ValueError):
            pass
    out = run([find_tool("ddcutil"), "detect", "--brief"], timeout=30)
    found = parse_detect(out, cfg.get("monitor", "mfg"), cfg.get("monitor", "model"))
    if found is None:
        raise LgError("monitor %s/%s not found by 'ddcutil detect'. Is DDC/CI enabled in the "
                      "monitor OSD and do you have access to /dev/i2c-*?" %
                      (cfg.get("monitor", "mfg"), cfg.get("monitor", "model")))
    ensure_runtime_dir()
    with open(BUS_CACHE_FILE, "w") as fh:
        fh.write(str(found))
    return found


def forget_bus_cache():
    with contextlib.suppress(OSError):
        os.unlink(BUS_CACHE_FILE)


def with_bus(cfg, fn):
    """Run fn(bus); if the cached bus fails, re-detect once and retry."""
    auto = cfg.get("monitor", "bus").strip().lower() in ("", "auto")
    bus = detect_bus(cfg)
    try:
        return fn(bus)
    except LgError:
        if not auto:
            raise
        forget_bus_cache()
        new_bus = detect_bus(cfg, use_cache=False)
        if new_bus == bus:
            raise
        return fn(new_bus)


# ---------------------------------------------------------------------------
# Brightness / contrast (standard MCCS via ddcutil)
# ---------------------------------------------------------------------------

def parse_getvcp(text):
    """Parse `ddcutil getvcp ... --brief` lines like 'VCP 10 C 94 100'."""
    values = {}
    for line in text.splitlines():
        m = re.match(r"VCP\s+([0-9A-Fa-f]{2})\s+C\s+(\d+)\s+(\d+)", line.strip())
        if m:
            values[int(m.group(1), 16)] = (int(m.group(2)), int(m.group(3)))
    return values


def check_level(value):
    if isinstance(value, int) and not isinstance(value, bool):
        ivalue = value
    elif isinstance(value, str) and re.fullmatch(r"\s*\d{1,3}\s*", value):
        ivalue = int(value)
    else:
        raise LgError("value must be an integer 0-100, got %r" % (value,))
    if not 0 <= ivalue <= 100:
        raise LgError("value must be between 0 and 100, got %d" % ivalue)
    return ivalue


def _read_vcp(bus, codes, attempts=3):
    """Read VCP codes (caller holds the lock). The monitor occasionally drops a
    reply, so retry a few times."""
    err = None
    for attempt in range(attempts):
        if attempt:
            time.sleep(0.2)
        try:
            out = run([find_tool("ddcutil"), "--bus", str(bus), "getvcp"] +
                      ["%02x" % c for c in codes] + ["--brief"])
        except LgError as exc:
            err = exc
            continue
        vals = parse_getvcp(out)
        if all(c in vals for c in codes):
            return vals
        err = LgError("could not read VCP %s: %s" % (" ".join("%02x" % c for c in codes), out.strip()))
    raise err


def get_levels(cfg):
    def read(bus):
        with ddc_lock():
            vals = _read_vcp(bus, [0x10, 0x12])
        return {"brightness": vals[0x10][0], "contrast": vals[0x12][0]}
    return with_bus(cfg, read)


def set_vcp(cfg, code, value):
    if code not in WRITABLE_VCP:  # hard safety net - never write anything else
        raise LgError("refusing to write VCP 0x%02X" % code)
    value = check_level(value)

    def write(bus):
        # The 32GN650 silently drops a write now and then, and ddcutil's own
        # verification reads back too early. So: write, wait, read back, retry.
        with ddc_lock():
            for attempt in range(3):
                run([find_tool("ddcutil"), "--bus", str(bus), "--noverify",
                     "setvcp", "%02x" % code, str(value)])
                time.sleep(0.12 + 0.1 * attempt)
                try:
                    if _read_vcp(bus, [code], attempts=2)[code][0] == value:
                        return value
                except LgError:
                    pass
        raise LgError("monitor did not accept %s=%d (DDC write not confirmed)" % (WRITABLE_VCP[code], value))
    return with_bus(cfg, write)


# ---------------------------------------------------------------------------
# Input switching (LG side-channel)
# ---------------------------------------------------------------------------

def lg_input_packet(value):
    """Build the 7-byte DDC/CI "Set VCP Feature" packet for LG register 0xF4,
    sent with source address 0x50. The checksum is the XOR of the destination
    address byte (0x37 << 1 = 0x6E) and all preceding packet bytes."""
    if value not in INPUTS.values():
        raise LgError("refusing to send unknown input value 0x%02X" % value)
    body = [LG_SOURCE_ADDR, 0x80 | 4, SET_VCP_OPCODE, LG_INPUT_REGISTER, 0x00, value]
    chk = DDC_ADDR << 1
    for b in body:
        chk ^= b
    return body + [chk]


def write_state(input_key, origin):
    ensure_runtime_dir()
    state = {"input": input_key, "time": time.time(), "origin": origin}
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh)
    os.replace(tmp, STATE_FILE)


def read_state():
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def switch_input(cfg, name=None, origin="cli"):
    if name in (None, "", "target"):
        name = cfg.get("monitor", "switch_target")
    elif name == "home":
        name = cfg.get("monitor", "home_input")
    key = normalize_input(name)
    packet = lg_input_packet(INPUTS[key])

    def send(bus):
        cmd = [find_tool("i2ctransfer"), "-y", str(bus), "w%d@0x%02x" % (len(packet), DDC_ADDR)]
        cmd += ["0x%02x" % b for b in packet]
        with ddc_lock():
            run(cmd)
        return key
    with_bus(cfg, send)
    write_state(key, origin)
    return key


# ---------------------------------------------------------------------------
# Token
# ---------------------------------------------------------------------------

def read_token():
    try:
        with open(TOKEN_FILE) as fh:
            tok = fh.read().strip()
    except OSError:
        return None
    return tok if len(tok) >= 16 else None


def ensure_token(regenerate=False):
    tok = None if regenerate else read_token()
    if tok:
        return tok
    os.makedirs(CONFIG_DIR, exist_ok=True)
    tok = secrets.token_urlsafe(24)
    old = os.umask(0o077)
    try:
        tmp = TOKEN_FILE + ".tmp"
        with open(tmp, "w") as fh:
            fh.write(tok + "\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, TOKEN_FILE)
    finally:
        os.umask(old)
    return tok


# ---------------------------------------------------------------------------
# LAN listener
# ---------------------------------------------------------------------------

MAX_BODY = 256


def client_allowed(addr, policy):
    if policy == "any":
        return True
    try:
        ip = ipaddress.ip_address(addr)
    except ValueError:
        return False
    if getattr(ip, "ipv4_mapped", None):
        ip = ip.ipv4_mapped
    return ip.is_private or ip.is_loopback or ip.is_link_local


class Backend:
    """What the listener calls; replaced by a fake in the tests."""

    def status(self, cfg):
        return get_levels(cfg)

    def set_vcp(self, cfg, code, value):
        return set_vcp(cfg, code, value)

    def switch(self, cfg, name):
        return switch_input(cfg, name, origin="listener")


class ListenerHandler(BaseHTTPRequestHandler):
    server_version = "lg-monitor/" + VERSION
    sys_version = ""
    timeout = 10
    backend = Backend()
    config_loader = staticmethod(load_config)
    token_loader = staticmethod(read_token)

    ROUTES = {
        ("GET", "/v1/ping"): "ping",
        ("GET", "/v1/status"): "status",
        ("POST", "/v1/brightness"): "brightness",
        ("POST", "/v1/contrast"): "contrast",
        ("POST", "/v1/switch"): "switch",
    }

    def log_message(self, fmt, *args):  # goes to the journal; never logs headers
        sys.stderr.write("%s %s\n" % (self.client_address[0], fmt % args))

    def _reply(self, code, payload):
        data = (json.dumps(payload) + "\n").encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def _handle(self, method):
        cfg = self.config_loader()
        if not client_allowed(self.client_address[0], cfg.get("listener", "allow").strip().lower()):
            return self._reply(403, {"ok": False, "error": "client address not allowed"})
        action = self.ROUTES.get((method, self.path.split("?", 1)[0]))
        if action is None:
            return self._reply(404, {"ok": False, "error": "unknown endpoint"})
        token = self.token_loader()
        auth = self.headers.get("Authorization", "")
        given = auth[7:].strip() if auth.startswith("Bearer ") else ""
        if not token or not hmac.compare_digest(given.encode(), token.encode()):
            time.sleep(0.5)  # slow down guessing
            return self._reply(401, {"ok": False, "error": "missing or invalid token"})

        body = {}
        if method == "POST":
            try:
                length = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                return self._reply(400, {"ok": False, "error": "bad Content-Length"})
            if length > MAX_BODY:
                return self._reply(413, {"ok": False, "error": "body too large"})
            raw = self.rfile.read(length) if length else b""
            if raw.strip():
                try:
                    body = json.loads(raw.decode("utf-8"))
                except (ValueError, UnicodeDecodeError):
                    return self._reply(400, {"ok": False, "error": "body must be JSON"})
                if not isinstance(body, dict):
                    return self._reply(400, {"ok": False, "error": "body must be a JSON object"})
        try:
            if action == "ping":
                return self._reply(200, {"ok": True, "version": VERSION})
            if action == "status":
                return self._reply(200, dict(ok=True, **self.backend.status(cfg)))
            if action in ("brightness", "contrast"):
                value = body.get("value")
                if isinstance(value, bool) or not isinstance(value, int) or not 0 <= value <= 100:
                    return self._reply(400, {"ok": False, "error": "value must be an integer 0-100"})
                code = 0x10 if action == "brightness" else 0x12
                self.backend.set_vcp(cfg, code, value)
                return self._reply(200, {"ok": True, action: value})
            if action == "switch":
                name = body.get("input", "home")
                if not isinstance(name, str) or (name != "home" and
                                                 INPUT_ALIASES.get(name.lower(), name.lower()) not in INPUTS):
                    return self._reply(400, {"ok": False, "error": "input must be one of: home, %s" %
                                             ", ".join(sorted(INPUTS))})
                key = self.backend.switch(cfg, name)
                return self._reply(200, {"ok": True, "input": key})
        except LgError as exc:
            return self._reply(500, {"ok": False, "error": str(exc)})
        return self._reply(500, {"ok": False, "error": "unhandled"})

    def do_GET(self):
        self._handle("GET")

    def do_POST(self):
        self._handle("POST")


class DualStackHTTPServer(HTTPServer):
    allow_reuse_address = True


def make_server(bind, port, handler=ListenerHandler):
    family = socket.AF_INET6 if ":" in bind else socket.AF_INET
    DualStackHTTPServer.address_family = family
    return DualStackHTTPServer((bind, port), handler)


def cmd_serve(cfg, args):
    if not read_token():
        raise LgError("no token in %s - run 'lg-monitor token --regenerate' first" % TOKEN_FILE)
    bind = args.bind or cfg.get("listener", "bind")
    port = args.port or cfg.getint("listener", "port")
    srv = make_server(bind, port)
    sys.stderr.write("lg-monitor listener on %s:%d (allow=%s)\n" % (bind, port, cfg.get("listener", "allow")))
    sys.stderr.flush()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


