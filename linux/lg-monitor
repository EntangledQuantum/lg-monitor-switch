def tilde(path):
    """Show paths under the home directory as ~/..."""
    return "~" + path[len(HOME):] if path and path.startswith(HOME + os.sep) else path


def deskflow_log_status(cfg, info=None):
    """Return (path or None, human readable explanation)."""
    path = cfg.get("deskflow", "log_file").strip()
    if path and path != "auto":
        path = os.path.expanduser(path)
        return path, ("using %s (set in lg-monitor config)%s" %
                      (tilde(path), "" if os.path.exists(path) else " - file does not exist yet"))
    info = info or deskflow_info()
    if info.get("log_to_file") and info.get("log_file"):
        path = os.path.expanduser(info["log_file"])
        if info.get("kind") == "flatpak" and not path.startswith(FLATPAK_DATA_DIR + os.sep):
            return None, ("Deskflow (Flatpak) logs to %s, which is outside its sandbox, so the file "
                          "is not visible here. Set Deskflow's log path to %s" % (tilde(path), RECOMMENDED_FLATPAK_LOG))
        return path, "using Deskflow's log file %s%s" % (
            tilde(path), "" if os.path.exists(path) else " (not created yet - restart the Deskflow server)")
    for pattern in (os.path.join(FLATPAK_DATA_DIR, "**/*.log"),
                    os.path.join(HOME, ".local/state/Deskflow/*.log"),
                    os.path.join(HOME, ".local/share/Deskflow/*.log")):
        hits = sorted(glob.glob(pattern, recursive=True), key=os.path.getmtime, reverse=True)
        if hits:
            return hits[0], "using the most recent Deskflow log file %s" % tilde(hits[0])
    return None, ("Deskflow's 'Log to file' is off. In Deskflow open Settings, tick 'Log to file', set the "
                  "path to %s and press OK/Apply." % (RECOMMENDED_FLATPAK_LOG if info.get("kind") == "flatpak"
                                                      else "~/deskflow.log"))


def deskflow_log_path(cfg, info=None):
    return deskflow_log_status(cfg, info)[0]


def screen_mapping(cfg):
    mapping = {}
    for screen, value in cfg.items("deskflow.screens"):
        value = value.strip().lower()
        if value in ("", "none", "off"):
            continue
        mapping[screen] = normalize_input(value)
    return mapping


class AutoSwitcher:
    """Pure decision logic for the Deskflow auto-switch (no I/O, unit-tested).

    Feed it log lines with on_line(); poll due() to find out whether a switch
    should happen now. A pending switch is cancelled when the cursor comes
    back before the delay expires.
    """

    def __init__(self, mapping, delay=5.0, cooldown=2.0, current=None):
        self.mapping = dict(mapping)
        self.delay = float(delay)
        self.cooldown = float(cooldown)
        self.current = current          # input we believe is displayed
        self.pending = None             # (input, deadline)
        self.last_switch = -1e9

    def on_line(self, line, now):
        m = SWITCH_LINE_RE.search(line)
        if not m:
            return None
        dest = m.group(2)
        target = self.mapping.get(dest)
        if target is None or target == self.current:
            self.pending = None
            return ("cancel" if target else "ignore", dest)
        self.pending = (target, now + self.delay)
        return ("schedule", dest)

    def due(self, now):
        if not self.pending:
            return None
        target, deadline = self.pending
        if now < deadline:
            return None
        if now - self.last_switch < self.cooldown:
            self.pending = (target, self.last_switch + self.cooldown)
            return None
        return target

    def mark_switched(self, target, now):
        self.current = target
        self.pending = None
        self.last_switch = now

    def sync_current(self, value):
        if value and value != self.current:
            self.current = value
            if self.pending and self.pending[0] == value:
                self.pending = None


class FileFollower:
    """`tail -F` for one file: survives rotation/truncation and late creation."""

    def __init__(self, path):
        self.path, self.fh, self.inode, self.buf = path, None, None, ""

    def _open(self, at_end):
        try:
            fh = open(self.path, encoding="utf-8", errors="replace")
        except OSError:
            return False
        st = os.fstat(fh.fileno())
        if at_end:
            fh.seek(0, os.SEEK_END)
        self.fh, self.inode = fh, st.st_ino
        return True

    def close(self):
        if self.fh is not None:
            self.fh.close()
            self.fh = None

    def lines(self, first=False):
        if self.fh is None and not self._open(at_end=first):
            return []
        try:
            st = os.stat(self.path)
            if st.st_ino != self.inode or st.st_size < self.fh.tell():
                self.fh.close()
                self.fh = None
                if not self._open(at_end=False):
                    return []
        except OSError:
            pass
        chunk = self.fh.read()
        if not chunk:
            return []
        self.buf += chunk
        *complete, self.buf = self.buf.split("\n")
        return complete


def cmd_deskflow_watch(cfg, args):
    log = lambda msg: (sys.stderr.write(time.strftime("%H:%M:%S ") + msg + "\n"), sys.stderr.flush())
    cfg_mtime = None

    def reload():
        nonlocal cfg, cfg_mtime
        try:
            mtime = os.path.getmtime(CONFIG_FILE)
        except OSError:
            mtime = 0
        if mtime != cfg_mtime:
            cfg_mtime = mtime
            cfg = load_config()
            return True
        return False

    reload()
    st = read_state()
    sw = AutoSwitcher(screen_mapping(cfg), cfg.getfloat("deskflow", "delay"),
                      cfg.getfloat("deskflow", "cooldown"),
                      current=(st or {}).get("input") or normalize_input(cfg.get("monitor", "home_input")))
    source = cfg.get("deskflow", "source").strip().lower()
    path, why = deskflow_log_status(cfg)
    log(why)
    if source == "file" or (source == "auto" and path):
        if not path:
            raise LgError("no Deskflow log file found. In Deskflow open Settings, tick 'Log to file' "
                          "and Apply, or set [deskflow] log_file in %s" % CONFIG_FILE)
        log("watching Deskflow log file %s" % path)
        follower = FileFollower(path)
        follower.lines(first=True)
        proc = None
    else:
        log("watching the user journal for Deskflow switch lines")
        proc = subprocess.Popen(["journalctl", "--user", "-f", "-n0", "-o", "cat"],
                                stdout=subprocess.PIPE, universal_newlines=True, bufsize=1)
        follower = None
    log("mapping: %s, delay %.1fs%s" % (sw.mapping or "(empty)", sw.delay, " [dry run]" if args.dry_run else ""))

    try:
        while True:
            if reload():
                sw.mapping = screen_mapping(cfg)
                sw.delay = cfg.getfloat("deskflow", "delay")
                sw.cooldown = cfg.getfloat("deskflow", "cooldown")
                log("config reloaded: mapping %s, delay %.1fs" % (sw.mapping, sw.delay))
            st = read_state()
            if st and st.get("origin") != "deskflow":
                sw.sync_current(st.get("input"))
            if proc is not None:
                ready, _, _ = select.select([proc.stdout], [], [], 0.25)
                lines = [proc.stdout.readline()] if ready else []
                if proc.poll() is not None:
                    raise LgError("journalctl exited")
            else:
                time.sleep(0.25)
                lines = follower.lines()
            now = time.monotonic()
            for line in lines:
                ev = sw.on_line(line, now)
                if ev:
                    log("cursor -> %s: %s" % (ev[1], ev[0]))
            target = sw.due(time.monotonic())
            if target:
                log("switching monitor to %s" % target)
                if not args.dry_run:
                    try:
                        switch_input(cfg, target, origin="deskflow")
                    except LgError as exc:
                        log("switch failed: %s" % exc)
                sw.mark_switched(target, time.monotonic())
    except KeyboardInterrupt:
        return 0
    finally:
        if proc is not None:
            proc.terminate()


