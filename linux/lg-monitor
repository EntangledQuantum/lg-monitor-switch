def cmd_get(cfg, args):
    info = {"switch_target": cfg.get("monitor", "switch_target"),
            "switch_label": cfg.get("monitor", "switch_target_name")}
    try:
        info.update(get_levels(cfg))
    except LgError as exc:
        if args.json:
            info["error"] = str(exc)
            print(json.dumps(info))
            return 1
        raise
    if args.json:
        print(json.dumps(info))
    else:
        print("brightness %d\ncontrast %d" % (info["brightness"], info["contrast"]))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog="lg-monitor", description=__doc__.split("\n\n")[0])
    p.add_argument("--version", action="version", version="lg-monitor " + VERSION)
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")
    g = sub.add_parser("get", help="print brightness and contrast")
    g.add_argument("--json", action="store_true")
    sub.add_parser("set-brightness", help="set brightness 0-100").add_argument("value")
    sub.add_parser("set-contrast", help="set contrast 0-100").add_argument("value")
    s = sub.add_parser("switch", help="switch input (default: configured switch_target)")
    s.add_argument("input", nargs="?", help="dp|dp1|dp2|hdmi1|hdmi2|home")
    sub.add_parser("detect", help="detect and print the monitor's I2C bus")
    sub.add_parser("packet", help="print the raw switch packets (no I/O)")
    t = sub.add_parser("token", help="print (or create) the LAN listener token")
    t.add_argument("--regenerate", action="store_true")
    sv = sub.add_parser("serve", help="run the LAN listener")
    sv.add_argument("--bind")
    sv.add_argument("--port", type=int)
    dw = sub.add_parser("deskflow-watch", help="auto-switch input when Deskflow moves the cursor")
    dw.add_argument("--dry-run", action="store_true", help="log decisions, never switch")
    sub.add_parser("deskflow-info", help="show what was detected about Deskflow (read-only)")
    svc = sub.add_parser("service", help="turn the LAN listener or Deskflow auto-switch on/off")
    svc.add_argument("feature", choices=sorted(FEATURE_UNITS))
    svc.add_argument("state", choices=["on", "off"])
    au = sub.add_parser("autostart", help="start enabled services at login (on/off) or show status")
    au.add_argument("state", choices=["on", "off", "status", "apply"], nargs="?", default="status",
                    help="apply = make systemd match the config file")
    tb = sub.add_parser("top-bar", help="show/hide the GNOME top bar menu (on/off) or show status")
    tb.add_argument("state", choices=["on", "off", "status"], nargs="?", default="status")
    args = p.parse_args(argv)
    if not args.cmd:
        p.print_help()
        return 2
    try:
        cfg = load_config()
        if args.cmd == "get":
            return cmd_get(cfg, args)
        if args.cmd == "set-brightness":
            print(set_vcp(cfg, 0x10, args.value))
        elif args.cmd == "set-contrast":
            print(set_vcp(cfg, 0x12, args.value))
        elif args.cmd == "switch":
            print("switched to %s" % INPUT_LABELS[switch_input(cfg, args.input)])
        elif args.cmd == "detect":
            forget_bus_cache()
            print("/dev/i2c-%d" % detect_bus(cfg, use_cache=False))
        elif args.cmd == "packet":
            for key, val in sorted(INPUTS.items()):
                print("%-6s %s" % (key, " ".join("0x%02x" % b for b in lg_input_packet(val))))
        elif args.cmd == "token":
            print(ensure_token(regenerate=args.regenerate))
        elif args.cmd == "serve":
            return cmd_serve(cfg, args)
        elif args.cmd == "deskflow-watch":
            return cmd_deskflow_watch(cfg, args)
        elif args.cmd == "deskflow-info":
            info = deskflow_info()
            rep = deskflow_log_report(cfg, info)
            info["log"] = rep
            info["mapping"] = effective_mapping(cfg, info)
            info["auto_switch_enabled"] = feature_enabled(cfg, "deskflow")
            info["watcher"] = read_watch_state()
            print(json.dumps(info, indent=2))
        elif args.cmd == "service":
            set_feature(cfg, args.feature, args.state == "on")
            print(json.dumps(services_status(cfg)[args.feature]))
        elif args.cmd == "autostart":
            if args.state == "apply":
                apply_services(cfg)
            elif args.state != "status":
                set_autostart(cfg, args.state == "on")
            print(json.dumps(services_status(cfg), indent=2))
        elif args.cmd == "top-bar":
            if args.state != "status":
                set_extension(args.state == "on")
            print("top bar menu: %s" % ("on" if extension_enabled() else "off"))
        return 0
    except LgError as exc:
        sys.stderr.write("lg-monitor: %s\n" % exc)
        return 1


if __name__ == "__main__":
    sys.exit(main())
