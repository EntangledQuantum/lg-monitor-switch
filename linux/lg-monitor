#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""lg-monitor - control an LG UltraGear monitor (brightness, contrast, input)
over DDC/CI from Linux.

Only three things are ever written to the monitor:
  * VCP 0x10 (brightness, 0-100)
  * VCP 0x12 (contrast, 0-100)
  * the input switch, sent as an LG manufacturer packet (register 0xF4,
    source address 0x50) because this monitor ignores the standard VCP 0x60.

Uses only the Python standard library plus the system tools `ddcutil` and
`i2ctransfer` (package i2c-tools). Run with /usr/bin/python3.
"""

import argparse
import configparser
import contextlib
import fcntl
import glob
import hmac
import ipaddress
import json
import os
import re
import secrets
import select
import shutil
import socket
