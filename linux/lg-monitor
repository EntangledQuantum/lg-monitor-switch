DESKFLOW_FLATPAK_ID = "org.deskflow.deskflow"
DESKFLOW_CONF_CANDIDATES = [
    os.path.join(HOME, ".var/app/org.deskflow.deskflow/config/Deskflow/Deskflow.conf"),
    os.path.join(HOME, ".config/Deskflow/Deskflow.conf"),
]
SWITCH_LINE_RE = re.compile(r'\b(?:switch|jump) from "([^"]+)" to "([^"]+)"')


def read_qt_ini(path):
    """Very small reader for Qt's .conf/ini format. Returns {section: {key: value}}."""
    data, section = {}, "General"
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith(("#", ";")):
                    continue
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1]
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    data.setdefault(section, {})[k.strip()] = v.strip()
    except OSError:
        return None
    return data


def parse_server_conf_screens(path):
    names = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return names
    for m in re.finditer(r"section:\s*(screens|links)\s*\n(.*?)\nend", text, re.S):
        for line in m.group(2).splitlines():
            s = line.strip()
            if s.endswith(":"):
                names.append(s[:-1].strip())
            elif "=" in s and m.group(1) == "links":
                names.append(s.split("=", 1)[1].strip())
    return names


def deskflow_info():
    """Detect Deskflow and gather (read-only) what we need from its settings."""
    info = {"installed": False, "kind": None, "config": None, "log_to_file": False,
            "log_file": None, "log_level": None, "screens": [], "local_screen": None}
    flatpak_dirs = ["/var/lib/flatpak/app/" + DESKFLOW_FLATPAK_ID,
                    os.path.join(HOME, ".local/share/flatpak/app", DESKFLOW_FLATPAK_ID)]
    if any(os.path.isdir(d) for d in flatpak_dirs):
        info.update(installed=True, kind="flatpak")
    elif shutil.which("deskflow") or shutil.which("deskflow-core"):
        info.update(installed=True, kind="native")
    for conf in DESKFLOW_CONF_CANDIDATES:
        data = read_qt_ini(conf)
        if data is None:
            continue
        info["installed"] = True
        info["kind"] = info["kind"] or ("flatpak" if "/.var/app/" in conf else "native")
        info["config"] = conf
        log = data.get("log", {})
        info["log_to_file"] = log.get("toFile", "false").lower() == "true"
        info["log_file"] = log.get("file") or None
        info["log_level"] = log.get("level")
        info["local_screen"] = data.get("core", {}).get("computerName")
        screens = []
        for sec, kv in data.items():
            if sec.startswith("computer_") and kv.get("name"):
                screens.append(kv["name"])
        server_conf = data.get("server", {}).get("externalConfigFile") or os.path.join(
            os.path.dirname(conf), "deskflow-server.conf")
        screens += parse_server_conf_screens(server_conf)
        if info["local_screen"]:
            screens.insert(0, info["local_screen"])
        seen = []
        for s in screens:
            if s and s not in seen:
                seen.append(s)
        info["screens"] = seen
        break
    return info


FLATPAK_DATA_DIR = os.path.join(HOME, ".var/app", DESKFLOW_FLATPAK_ID)
