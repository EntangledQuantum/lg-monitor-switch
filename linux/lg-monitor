# Deskflow writes "switch from" lines at level INFO; these levels hide them.
QUIET_LOG_LEVELS = ("FATAL", "ERROR", "WARNING", "NOTE")


def _home(home=None):
    return home or os.path.expanduser("~")


def flatpak_data_dir(home=None):
    return os.path.join(_home(home), ".var/app", DESKFLOW_FLATPAK_ID)


def recommended_flatpak_log(home=None):
    return os.path.join(flatpak_data_dir(home), "data", "deskflow.log")


def deskflow_conf_candidates(home=None):
    home = _home(home)
    paths = [os.path.join(flatpak_data_dir(home), "config/Deskflow/Deskflow.conf"),
             os.path.join(home, ".config/Deskflow/Deskflow.conf")]
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg and not xdg.startswith(os.path.join(home, ".config")):
        paths.append(os.path.join(xdg, "Deskflow/Deskflow.conf"))
    return paths


def read_qt_ini(path):
    """Very small reader for Qt's .conf/ini format. Returns {section: {key: value}}."""
    data, section = {}, "General"
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith(("#", ";")):
                    continue
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1]
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    data.setdefault(section, {})[k.strip()] = v.strip()
    except OSError:
        return None
    return data


def parse_server_conf_screens(path):
    names = []
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        return names
    for m in re.finditer(r"section:\s*(screens|links)\s*\n(.*?)\nend", text, re.S):
        for line in m.group(2).splitlines():
            s = line.strip()
            if s.endswith(":"):
                names.append(s[:-1].strip())
            elif "=" in s and m.group(1) == "links":
                names.append(s.split("=", 1)[1].strip())
    return names


def _is_flatpak_wrapper(path):
    """True for small shell scripts that just run the Flatpak (e.g. /usr/local/bin/deskflow)."""
    try:
        if os.path.getsize(path) > 4096:
            return False
        with open(path, "rb") as fh:
            return b"flatpak run" in fh.read()
    except OSError:
        return False


def deskflow_installs(home=None):
    """All Deskflow installations found, as [(kind, location)]. Read-only."""
    home = _home(home)
    found = []
    for d in ("/var/lib/flatpak/app/" + DESKFLOW_FLATPAK_ID,
              os.path.join(home, ".local/share/flatpak/app", DESKFLOW_FLATPAK_ID)):
        if os.path.isdir(d):
            found.append(("flatpak", d))
            break
    for name in ("deskflow", "deskflow-core", "deskflow-server"):
        cands = [shutil.which(name)] + [os.path.join(d, name) for d in
                                         ("/usr/bin", "/usr/local/bin", "/opt/deskflow/bin", "/opt/deskflow")]
        hit = next((p for p in cands if p and os.access(p, os.X_OK) and not _is_flatpak_wrapper(p)), None)
        if hit:
            found.append(("native", hit))
            break
    images = []
    for d in ("Applications", ".local/bin", "bin", "Downloads", ".local/share/applications"):
        images += glob.glob(os.path.join(home, d, "*[Dd]eskflow*.[Aa]pp[Ii]mage"))
    images += glob.glob("/opt/*[Dd]eskflow*.[Aa]pp[Ii]mage")
    if images:
        found.append(("appimage", max(images, key=os.path.getmtime)))
    return found


def deskflow_running(proc_root="/proc"):
    """Return 'flatpak', 'native' or None depending on a running Deskflow process."""
    try:
        pids = [p for p in os.listdir(proc_root) if p.isdigit()]
    except OSError:
        return None
    for pid in pids:
        try:
            with open(os.path.join(proc_root, pid, "comm")) as fh:
                comm = fh.read().strip()
            if not comm.startswith("deskflow"):
                continue
            with open(os.path.join(proc_root, pid, "cmdline"), "rb") as fh:
                cmd = fh.read().split(b"\0")[0].decode(errors="replace")
            with open(os.path.join(proc_root, pid, "cgroup"), errors="replace") as fh:
                cgroup = fh.read()
        except OSError:
            continue
        sandboxed = (cmd.startswith("/app/") or "app-flatpak-" in cgroup
                     or os.path.exists(os.path.join(proc_root, pid, "root", ".flatpak-info")))
        return "flatpak" if sandboxed else "native"
    return None


def deskflow_info(home=None, running=None):
    """Detect Deskflow and gather (read-only) what we need from its settings."""
    home = _home(home)
    installs = deskflow_installs(home)
    if running is None:
        running = deskflow_running()
    info = {"installed": bool(installs), "kind": None, "installs": [k for k, _ in installs],
            "running": running, "config": None, "server_config": None, "log_to_file": False,
            "log_file": None, "log_level": None, "screens": [], "local_screen": None}
    confs = [c for c in deskflow_conf_candidates(home) if os.path.isfile(c)]
    if running == "flatpak":
        confs.sort(key=lambda c: "/.var/app/" not in c)
    elif running == "native":
        confs.sort(key=lambda c: "/.var/app/" in c)
    elif confs:
        confs.sort(key=os.path.getmtime, reverse=True)
    if confs:
        info["config"] = conf = confs[0]
        info["installed"] = True
        data = read_qt_ini(conf) or {}
        log = data.get("log", {})
        info["log_to_file"] = log.get("toFile", "false").lower() == "true"
        info["log_file"] = os.path.expanduser(log["file"]) if log.get("file") else None
        info["log_level"] = log.get("level")
        info["local_screen"] = data.get("core", {}).get("computerName")
        screens = [kv["name"] for sec, kv in data.items() if sec.startswith("computer_") and kv.get("name")]
        server_conf = data.get("server", {}).get("externalConfigFile") or os.path.join(
            os.path.dirname(conf), "deskflow-server.conf")
        info["server_config"] = server_conf
        screens += parse_server_conf_screens(server_conf)
        if info["local_screen"]:
            screens.insert(0, info["local_screen"])
        info["screens"] = list(dict.fromkeys(s for s in screens if s))
    info["kind"] = running or ("flatpak" if info["config"] and "/.var/app/" in info["config"] else None) \
        or (installs[0][0] if installs else None)
    return info


def tilde(path, home=None):
    """Show paths under the home directory as ~/..."""
    home = _home(home)
    return "~" + path[len(home):] if path and path.startswith(home + os.sep) else path


def deskflow_log_candidates(info, home=None):
    """Existing Deskflow log files, most recently modified first."""
    home = _home(home)
    pats = [os.path.join(flatpak_data_dir(home), "**", "*.log"),
            os.path.join(home, ".local/state/Deskflow/**/*.log"),
            os.path.join(home, ".local/share/Deskflow/**/*.log"),
            os.path.join(home, ".config/Deskflow/*.log"),
            os.path.join(home, "deskflow*.log")]
    files = []
    for pat in pats:
        files += glob.glob(pat, recursive=True)
    conf_file = info.get("log_file")
    if conf_file and os.path.isfile(conf_file) and not (
            info.get("kind") == "flatpak" and not conf_file.startswith(flatpak_data_dir(home) + os.sep)):
        files.append(conf_file)
    if info.get("kind") == "flatpak":
        # A Flatpak Deskflow cannot have written logs outside its sandbox.
        files = [f for f in files if f.startswith(flatpak_data_dir(home) + os.sep)]
    files = [f for f in dict.fromkeys(files) if os.path.isfile(f)]
    return sorted(files, key=os.path.getmtime, reverse=True)


def _age(path, now=None):
    try:
        return max(0.0, (now or time.time()) - os.path.getmtime(path))
    except OSError:
        return None


def human_age(seconds):
    if seconds is None:
        return "never"
    if seconds < 90:
        return "%d s ago" % seconds
    if seconds < 5400:
        return "%d min ago" % (seconds // 60)
    if seconds < 172800:
        return "%d h ago" % (seconds // 3600)
    return "%d days ago" % (seconds // 86400)


def deskflow_log_report(cfg, info=None, home=None, now=None):
    """Work out which Deskflow log file to follow and explain the situation.

    Returns a dict: path (file to follow or None), state, message, usable
    (path exists), recommended (path to type into Deskflow), age (seconds since
    the file was written). States: manual, manual_missing, ok, not_created,
    outside_sandbox, off, not_installed.
    """
    home = _home(home)
    info = info if info is not None else deskflow_info(home)
    flatpak = info.get("kind") == "flatpak"
    rec = recommended_flatpak_log(home) if flatpak else os.path.join(home, "deskflow.log")
    rep = {"path": None, "state": None, "message": "", "recommended": rec, "age": None, "usable": False}
    cands = deskflow_log_candidates(info, home)

    def fallback_note(path):
        return (" Meanwhile following %s (written %s)." % (tilde(path, home), human_age(_age(path, now)))
                if path else "")

    manual = cfg.get("deskflow", "log_file", fallback="auto").strip()
    if manual and manual.lower() != "auto":
        mpath = os.path.expanduser(manual)
        if os.path.isfile(mpath):
            rep.update(path=mpath, state="manual",
                       message="Following %s (custom path set in LG Monitor Switch)." % tilde(mpath, home))
        else:
            alt = cands[0] if cands else None
            rep.update(path=alt or mpath, state="manual_missing",
                       message="The custom log path %s does not exist. Clear it to use automatic detection."
                       % tilde(mpath, home) + fallback_note(alt))
    elif not info.get("installed"):
        rep.update(state="not_installed", message="Deskflow was not found.")
    elif info.get("log_to_file") and info.get("log_file"):
        conf = info["log_file"]
        if flatpak and not conf.startswith(flatpak_data_dir(home) + os.sep):
            alt = cands[0] if cands else None
            rep.update(path=alt, state="outside_sandbox",
                       message="Deskflow (Flatpak) is set to log to %s, which is outside its sandbox, so "
                               "nothing is written there. In Deskflow's Settings set the log path to %s."
                               % (tilde(conf, home), rec) + fallback_note(alt))
        elif os.path.isfile(conf):
            rep.update(path=conf, state="ok",
                       message="Deskflow logs to %s (last written %s)." % (tilde(conf, home),
                                                                           human_age(_age(conf, now))))
        else:
            rep.update(path=conf, state="not_created",
                       message="Deskflow will log to %s, but the file does not exist yet. Press OK/Apply in "
                               "Deskflow's settings or restart its server." % tilde(conf, home))
    else:
        alt = cands[0] if cands else None
        rep.update(path=alt, state="off",
                   message="Deskflow's 'Log to file' is off. In Deskflow's Settings tick 'Log to file' and set "
                           "the path to %s." % rec + fallback_note(alt))
    level = (info.get("log_level") or "").upper()
    if level in QUIET_LOG_LEVELS:
        rep["message"] += " Deskflow's log level is %s; set it to Info (or more detailed), " \
                          "otherwise screen switches are not logged." % level.title()
    if rep["path"]:
        rep["usable"] = os.path.isfile(rep["path"])
        rep["age"] = _age(rep["path"], now)
    return rep


def deskflow_log_status(cfg, info=None):
    rep = deskflow_log_report(cfg, info)
    return rep["path"], rep["message"]


def deskflow_log_path(cfg, info=None):
    return deskflow_log_report(cfg, info)["path"]


def screen_mapping(cfg):
    mapping = {}
    for screen, value in cfg.items("deskflow.screens"):
        value = value.strip().lower()
        if value in ("", "none", "off"):
            continue
        mapping[screen] = normalize_input(value)
    return mapping


def default_screen_input(cfg, screen, info):
    """Input used for a Deskflow screen that has no entry in [deskflow.screens]:
    this computer -> home_input, any other screen -> switch_target."""
    key = "home_input" if screen == (info or {}).get("local_screen") else "switch_target"
    return normalize_input(cfg.get("monitor", key))


def effective_mapping(cfg, info=None):
    """Explicit [deskflow.screens] entries plus defaults for screens that
    Deskflow knows about but the config does not mention yet."""
    explicit = {k: v.strip().lower() for k, v in cfg.items("deskflow.screens")}
    mapping = {}
    for screen in (info or {}).get("screens", []):
        if screen not in explicit:
            mapping[screen] = default_screen_input(cfg, screen, info)
    mapping.update(screen_mapping(cfg))
    return mapping


class AutoSwitcher:
    """Pure decision logic for the Deskflow auto-switch (no I/O, unit-tested).

    Feed it log lines with on_line(); poll due() to find out whether a switch
    should happen now. A pending switch is cancelled when the cursor comes
    back before the delay expires.
    """

    def __init__(self, mapping, delay=5.0, cooldown=2.0, current=None):
        self.mapping = dict(mapping)
        self.delay = float(delay)
        self.cooldown = float(cooldown)
        self.current = current          # input we believe is displayed
        self.pending = None             # (input, deadline)
        self.last_switch = -1e9

    def on_line(self, line, now):
        m = SWITCH_LINE_RE.search(line)
        if not m:
            return None
        dest = m.group(2)
        target = self.mapping.get(dest)
        if target is None or target == self.current:
            self.pending = None
            return ("cancel" if target else "ignore", dest)
        self.pending = (target, now + self.delay)
        return ("schedule", dest)

    def due(self, now):
        if not self.pending:
            return None
        target, deadline = self.pending
        if now < deadline:
            return None
        if now - self.last_switch < self.cooldown:
            self.pending = (target, self.last_switch + self.cooldown)
            return None
        return target

    def mark_switched(self, target, now):
        self.current = target
        self.pending = None
        self.last_switch = now

    def mark_failed(self, now):
        """The switch command failed: forget it, but keep `current` unchanged so
        the next cursor move is not mistaken for 'already there'."""
        self.pending = None
        self.last_switch = now

    def sync_current(self, value):
        if value and value != self.current:
            self.current = value
            if self.pending and self.pending[0] == value:
                self.pending = None


class FileFollower:
    """`tail -F` for one file: survives rotation/truncation and late creation."""

    def __init__(self, path):
        self.path, self.fh, self.inode, self.buf = path, None, None, ""

    def _open(self, at_end):
        try:
            fh = open(self.path, encoding="utf-8", errors="replace")
        except OSError:
            return False
        st = os.fstat(fh.fileno())
        if at_end:
            fh.seek(0, os.SEEK_END)
        self.fh, self.inode, self.buf = fh, st.st_ino, ""
        return True

    def close(self):
        if self.fh is not None:
            self.fh.close()
            self.fh = None

    def lines(self, first=False):
        if self.fh is None and not self._open(at_end=first):
            return []
        out = []
        try:
            st = os.stat(self.path)
            if st.st_ino != self.inode or st.st_size < self.fh.tell():
                # Rotated or truncated: finish the old file, then start the new one from the top.
                out += self._read()
                self.fh.close()
                self.fh = None
                if not self._open(at_end=False):
                    return out
        except OSError:
            pass
        return out + self._read()

    def _read(self):
        chunk = self.fh.read()
        if not chunk:
            return []
        self.buf += chunk
        *complete, self.buf = self.buf.split("\n")
        return complete


class JournalFollower:
    """Follow `journalctl --user -f` (or a test command) without blocking."""

    def __init__(self, cmd=None):
        self.proc = subprocess.Popen(cmd or ["journalctl", "--user", "-f", "-n0", "-o", "cat"],
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        os.set_blocking(self.proc.stdout.fileno(), False)
        self.buf = b""

    def lines(self, timeout=0.0):
        if self.proc.poll() is not None:
            raise LgError("journal follower exited")
        ready, _, _ = select.select([self.proc.stdout], [], [], timeout)
        if not ready:
            return []
        while True:
            try:
                chunk = os.read(self.proc.stdout.fileno(), 65536)
            except BlockingIOError:
                break
            if not chunk:
                break
            self.buf += chunk
        *complete, self.buf = self.buf.split(b"\n")
        return [c.decode("utf-8", "replace") for c in complete]

    def close(self):
        if self.proc.poll() is None:
            self.proc.terminate()
            try:
                self.proc.wait(2)
            except subprocess.TimeoutExpired:
                self.proc.kill()
        self.proc.stdout.close()


def _write_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(data, fh)
    os.replace(tmp, path)


def read_watch_state(path=None):
    """Health of the running watcher, or None. Adds 'alive' (process exists)."""
    try:
        with open(path or WATCH_STATE_FILE) as fh:
            st = json.load(fh)
    except (OSError, ValueError):
        return None
    try:
        os.kill(int(st.get("pid", 0)), 0)
        st["alive"] = True
    except (OSError, ValueError):
        st["alive"] = False
    return st


class DeskflowWatcher:
    """The Deskflow auto-switch service.

    Detection (Deskflow install, its settings, which log file to follow, the
    screen mapping) runs again ONLY when a settings file changes: lg-monitor's
    config.ini, Deskflow.conf or Deskflow's server config. While no usable log
    file exists yet it also retries every RETRY_INTERVAL seconds, and stops
    retrying as soon as one is found.
    """

    RETRY_INTERVAL = 7.0
    HEARTBEAT = 15.0

    def __init__(self, dry_run=False, switch_fn=None, log=None, config_path=None, home=None,
                 state_file=None, journal_cmd=None, state_reader=read_state, clock=time.monotonic,
                 info_fn=None):
        self.dry_run = dry_run
        self.switch_fn = switch_fn or (lambda cfg, target: switch_input(cfg, target, origin="deskflow"))
        self.log = log or (lambda msg: (sys.stderr.write(time.strftime("%H:%M:%S ") + msg + "\n"),
                                        sys.stderr.flush()))
        self.config_path = config_path or CONFIG_FILE
        self.home = _home(home)
        self.state_file = state_file or WATCH_STATE_FILE
        self.journal_cmd = journal_cmd
        self.state_reader = state_reader
        self.clock = clock
        self.info_fn = info_fn or (lambda: deskflow_info(self.home))
        self.cfg = None
        self.info = {}
        self.report = {}
        self.sw = None
        self.follower = None
        self.source = None             # ("file", path) | ("journal", None) | ("none", None)
        self.mtimes = None
        self.next_retry = None
        self.detections = 0
        self.health = {"pid": os.getpid(), "started": time.time(), "dry_run": dry_run,
                       "last_line": None, "last_event": None, "last_switch": None}
        self.last_heartbeat = 0.0

    # ---- settings files ---------------------------------------------------
    def _watched_files(self):
        files = [self.config_path] + deskflow_conf_candidates(self.home)
        if self.info.get("server_config"):
            files.append(self.info["server_config"])
        return files

    def _mtimes(self):
        out = []
        for f in self._watched_files():
            try:
                out.append(os.stat(f).st_mtime_ns)
            except OSError:
                out.append(None)
        return tuple(out)

    # ---- detection --------------------------------------------------------
    def detect(self, reason):
        self.detections += 1
        self.cfg = load_config(self.config_path)
        self.info = self.info_fn()
        rep = deskflow_log_report(self.cfg, self.info, self.home)
        mapping = effective_mapping(self.cfg, self.info)
        delay = self.cfg.getfloat("deskflow", "delay")
        cooldown = self.cfg.getfloat("deskflow", "cooldown")
        if self.sw is None:
            st = self.state_reader()
            self.sw = AutoSwitcher(mapping, delay, cooldown, current=(st or {}).get("input") or
                                   normalize_input(self.cfg.get("monitor", "home_input")))
            self.log("mapping %s, delay %gs%s" % (mapping or "(empty)", delay, " [dry run]" if self.dry_run else ""))
        elif (mapping, delay, cooldown) != (self.sw.mapping, self.sw.delay, self.sw.cooldown):
            self.sw.mapping, self.sw.delay, self.sw.cooldown = mapping, delay, cooldown
            self.log("settings changed: mapping %s, delay %gs" % (mapping or "(empty)", delay))
        if rep.get("message") != self.report.get("message"):
            self.log(rep["message"])
        self.report = rep

        mode = self.cfg.get("deskflow", "source").strip().lower()
        if mode == "journal":
            want = ("journal", None)
        elif rep["path"]:
            want = ("file", rep["path"])
        elif mode == "file":
            want = ("none", None)
        else:
            want = ("journal", None)    # last resort while nothing better exists
        if want != self.source:
            self._switch_source(want, reason)
        # Retry slowly only while there is no usable log file (and the user did
        # not explicitly ask for the journal).
        searching = mode != "journal" and not rep["usable"]
        self.next_retry = self.clock() + self.RETRY_INTERVAL if searching else None
        self.mtimes = self._mtimes()
        self._write_health(force=True)

    def _switch_source(self, want, reason):
        if self.follower is not None:
            self.follower.close()
            self.follower = None
        old = self.source
        self.source = want
        kind, path = want
        if kind == "file":
            self.follower = FileFollower(path)
            self.follower.lines(first=True)     # existing file: start at its end
        elif kind == "journal":
            self.follower = JournalFollower(self.journal_cmd)
        desc = {"file": "log file %s" % path, "journal": "the user journal (fallback)",
                "none": "nothing (no log file yet)"}[kind]
        self.log("%s %s (%s)" % ("now following" if old else "following", desc, reason))

    # ---- health -----------------------------------------------------------
    def _write_health(self, force=False):
        now = time.time()
        if not force and now - self.last_heartbeat < self.HEARTBEAT:
            return
        self.last_heartbeat = now
        kind, path = self.source or ("none", None)
        self.health.update(updated=now, source=kind, path=path, state=self.report.get("state"),
                           message=self.report.get("message"),
                           searching=self.next_retry is not None,
                           mapping=self.sw.mapping if self.sw else {})
        try:
            _write_json(self.state_file, self.health)
        except OSError:
            pass

    # ---- main loop --------------------------------------------------------
    def step(self, timeout=0.25):
        if self.cfg is None:
            self.detect("start")
        elif self._mtimes() != self.mtimes:
            self.detect("settings changed")
        elif self.next_retry is not None and self.clock() >= self.next_retry:
            self.detect("retry")

        st = self.state_reader()
        if st and st.get("origin") != "deskflow":
            self.sw.sync_current(st.get("input"))

        if isinstance(self.follower, JournalFollower):
            try:
                lines = self.follower.lines(timeout)
            except LgError as exc:
                self.log(str(exc))
                self.follower, self.source = None, None
                lines = []
        else:
            if timeout:
                time.sleep(timeout)
            lines = self.follower.lines() if self.follower else []

        now = self.clock()
        for line in lines:
            ev = self.sw.on_line(line, now)
            if ev:
                self.log("cursor -> %s: %s" % (ev[1], ev[0]))
                self.health["last_line"] = time.time()
                self.health["last_event"] = "%s -> %s" % (ev[1], ev[0])
                self._write_health(force=True)
        target = self.sw.due(self.clock())
        if target:
            self.log("switching monitor to %s%s" % (target, " (dry run)" if self.dry_run else ""))
            ok = True
            if not self.dry_run:
                try:
                    self.switch_fn(self.cfg, target)
                except LgError as exc:
                    ok = False
                    self.log("switch failed: %s" % exc)
            if ok:
                self.sw.mark_switched(target, self.clock())
            else:
                self.sw.mark_failed(self.clock())
            self.health["last_switch"] = {"time": time.time(), "input": target, "ok": ok}
            self._write_health(force=True)
        self._write_health()
        return lines

    def close(self):
        if self.follower is not None:
            self.follower.close()
            self.follower = None


def cmd_deskflow_watch(cfg, args):
    watcher = DeskflowWatcher(dry_run=args.dry_run)
    try:
        while True:
            watcher.step()
    except KeyboardInterrupt:
        return 0
    finally:
        watcher.close()


# ---------------------------------------------------------------------------
# systemd --user helpers (used by the settings app)
# ---------------------------------------------------------------------------

def systemctl(*args):
    res = subprocess.run(["systemctl", "--user"] + list(args), stdout=subprocess.PIPE,
                         stderr=subprocess.PIPE, universal_newlines=True)
    return res.returncode, (res.stdout + res.stderr).strip()


def unit_enabled(unit):
    return systemctl("is-enabled", unit)[1].splitlines()[:1] == ["enabled"]


def unit_active(unit):
    return systemctl("is-active", unit)[1].splitlines()[:1] == ["active"]


def _systemctl_ok(*args):
    rc, out = systemctl(*args)
    if rc != 0:
        raise LgError(out or "systemctl %s failed" % " ".join(args))


FEATURE_UNITS = {"listener": LISTENER_UNIT, "deskflow": DESKFLOW_UNIT}
EXTENSION_UUID = "lg-monitor-switch@entangledquantum.github.io"


def feature_enabled(cfg, feature):
    return cfg.getboolean(feature, "enabled", fallback=False)


def apply_services(cfg, only=None):
    """Make systemd match the config: enabled features run now, and start at
    login only while [general] autostart is on. Disabled features are stopped.
    `only` limits the change to one feature."""
    autostart = cfg.getboolean("general", "autostart", fallback=True)
    _systemctl_ok("daemon-reload")
    for feature, unit in FEATURE_UNITS.items():
        if only and feature != only:
            continue
        if feature_enabled(cfg, feature):
            if feature == "listener":
                ensure_token()
            _systemctl_ok("enable" if autostart else "disable", unit)
            if not unit_active(unit):
                systemctl("reset-failed", unit)
                _systemctl_ok("start", unit)
        else:
            _systemctl_ok("disable", "--now", unit)


def set_feature(cfg, feature, on):
    cfg.set(feature, "enabled", "true" if on else "false")
    save_config(cfg)
    apply_services(cfg, only=feature)


def set_autostart(cfg, on):
    cfg.set("general", "autostart", "true" if on else "false")
    save_config(cfg)
    apply_services(cfg)


def autostart_state(cfg):
    """Real state: on if every enabled feature's unit is enabled in systemd.
    With no feature enabled there is nothing to start, so use the config."""
    enabled = [u for f, u in FEATURE_UNITS.items() if feature_enabled(cfg, f)]
    if not enabled:
        return cfg.getboolean("general", "autostart", fallback=True)
    return all(unit_enabled(u) for u in enabled)


def _enabled_extensions():
    import ast
    raw = subprocess.run(["gsettings", "get", "org.gnome.shell", "enabled-extensions"],
                         stdout=subprocess.PIPE, universal_newlines=True).stdout.strip()
    if not raw or raw.startswith("@as"):
        return []
    try:
        return list(ast.literal_eval(raw))
    except (ValueError, SyntaxError):
        return []


def extension_enabled():
    return EXTENSION_UUID in _enabled_extensions()


def set_extension(on):
    """Show/hide the top bar menu. gnome-extensions only knows extensions the
    running shell has loaded, so fall back to editing the gsettings list."""
    rc = subprocess.run(["gnome-extensions", "enable" if on else "disable", EXTENSION_UUID],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    cur = _enabled_extensions()
    if rc != 0 or (EXTENSION_UUID in cur) != on:
        cur = [u for u in cur if u != EXTENSION_UUID] + ([EXTENSION_UUID] if on else [])
        subprocess.run(["gsettings", "set", "org.gnome.shell", "enabled-extensions", str(cur)], check=False)


def services_status(cfg):
    out = {"autostart": autostart_state(cfg), "top_bar_extension": extension_enabled()}
    for feature, unit in FEATURE_UNITS.items():
        out[feature] = {"enabled": feature_enabled(cfg, feature), "unit": unit,
                        "starts_at_login": unit_enabled(unit), "running": unit_active(unit)}
    return out


def lan_addresses():
    addrs = []
    try:
        out = subprocess.run(["hostname", "-I"], stdout=subprocess.PIPE, universal_newlines=True).stdout
        for a in out.split():
            try:
                ip = ipaddress.ip_address(a)
            except ValueError:
                continue
            if ip.version == 4 and ip.is_private and not a.startswith("172.17."):
                addrs.append(a)
    except OSError:
        pass
    return addrs


